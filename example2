-- ===========================================================
-- API reference
-- ===========================================================
--[[

Window:
    Library:visible()                    -- toggle UI on/off
    Library:exist()                      -- is UI alive
    Library:disconnect()                 -- disconnect all connections
    Library:clear()                      -- destroy UI

Configs:
    Library:SaveConfig(name)             -- Moondiety/Configs/<name>.json
    Library:LoadConfig(name)
    Library:DeleteConfig(name)
    Library:ListConfigs()                -- returns array of names

Themes:
    Library:SetTheme("Dark")
    Library:SetTheme("Sapphire")
    Library:SetTheme("Amethyst")
    Library.Theme                        -- current theme name

Flags:
    Library.Flags.<flag>                 -- read/write value

Objects:
    Library.Objects.<flag>:GetValue()
    Library.Objects.<flag>:SetValue(v)

Notes:
    tab.create_note({
        title = 'Warning',               -- optional; 13px SemiBold
        description = 'line1\nline2',    -- 11px Regular, wraps, supports \n
        color = '#613EA7',               -- hex color for the left stripe
        section = 'left',                -- 'left' | 'right' | 'middle'
        flag = 'note_flag'               -- optional; makes it configurable
    })

    NoteObj:GetValue()                   -- current description text
    NoteObj:SetValue(text)               -- set description
    NoteObj:SetTitle(text)               -- set title
    NoteObj:SetColor('#RRGGBB')          -- change stripe color

]]
