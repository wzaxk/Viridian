-- ═══════════════════════════════════════════════════════════
-- PLAYER TAB
-- ═══════════════════════════════════════════════════════════

tab2.create_title({
    name = 'Character',
    section = 'left'
})

tab2.create_slider({
    name = 'WalkSpeed',
    flag = 'walkspeed',
    section = 'left',
    value = 16,
    minimum_value = 1,
    maximum_value = 200,
    callback = function(value)
        local char = game:GetService('Players').LocalPlayer.Character
        if char and char:FindFirstChildOfClass('Humanoid') then
            char:FindFirstChildOfClass('Humanoid').WalkSpeed = value
        end
    end
})

tab2.create_slider({
    name = 'JumpPower',
    flag = 'jumppower',
    section = 'left',
    value = 50,
    minimum_value = 1,
    maximum_value = 300,
    callback = function(value)
        local char = game:GetService('Players').LocalPlayer.Character
        if char and char:FindFirstChildOfClass('Humanoid') then
            char:FindFirstChildOfClass('Humanoid').JumpPower = value
        end
    end
})

tab2.create_toggle({
    name = 'Infinite Jump',
    flag = 'infinitejump',
    section = 'left',
    enabled = false,
    callback = function(state)
        print('[InfiniteJump]', state)
    end
})

tab2.create_button({
    name = 'Reset Character',
    section = 'left',
    callback = function()
        local char = game:GetService('Players').LocalPlayer.Character
        if char and char:FindFirstChildOfClass('Humanoid') then
            char:FindFirstChildOfClass('Humanoid').Health = 0
        end
    end
})

