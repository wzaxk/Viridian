-- ===========================================================
-- TAB 2 — layout (left / middle / right flow)
-- ===========================================================
--
-- Grid has two columns: left and right.
-- section = 'left'   -> element goes into the left column
-- section = 'right'  -> element goes into the right column
-- section = 'middle' -> element takes full width and breaks the flow,
--                       everything created after it moves below.
--
-- Example:
--   left 1   |  right 1
--   left 2   |
--   ------- middle -------
--            |  right 2
--

tab2.create_title({ name = 'left', section = 'left' })
tab2.create_title({ name = 'right', section = 'right' })

tab2.create_button({
    name = 'left 1',
    section = 'left',
    callback = function() end
})

tab2.create_button({
    name = 'right 1',
    section = 'right',
    callback = function() end
})

tab2.create_button({
    name = 'left 2',
    section = 'left',
    callback = function() end
})

tab2.create_button({
    name = 'middle (full width)',
    section = 'middle',
    callback = function() end
})

tab2.create_button({
    name = 'right 2 (after middle)',
    section = 'right',
    callback = function() end
})

tab2.create_button({
    name = 'left 3 (after middle)',
    section = 'left',
    callback = function() end
})

