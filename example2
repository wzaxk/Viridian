-- SETTINGS TAB (configs + themes)
-- ═══════════════════════════════════════════════════════════

tab3.create_title({
    name = 'Configs',
    section = 'left'
})

tab3.create_input({
    name = 'Config Name',
    flag = 'configname',
    section = 'left',
    default = 'myconfig',
    placeholder = 'config name'
})

tab3.create_button({
    name = 'Save Config',
    section = 'left',
    callback = function()
        Library:SaveConfig(Library.Flags.configname or 'myconfig')
    end
})

tab3.create_button({
    name = 'Load Config',
    section = 'left',
    callback = function()
        Library:LoadConfig(Library.Flags.configname or 'myconfig')
    end
})

tab3.create_button({
    name = 'Delete Config',
    section = 'left',
    callback = function()
        Library:DeleteConfig(Library.Flags.configname or 'myconfig')
    end
})

tab3.create_dropdown({
    name = 'Saved Configs',
    flag = 'savedconfigs',
    section = 'left',
    option = 'None',
    options = (function()
        local list = Library:ListConfigs()
        if #list == 0 then return { 'None' } end
        return list
    end)(),
    callback = function(value)
        Library.Flags.configname = value
    end
})

tab3.create_title({
    name = 'Appearance',
    section = 'right'
})

tab3.create_dropdown({
    name = 'Theme',
    flag = 'themeselect',
    section = 'right',
    option = Library.Theme or 'Dark',
    options = { 'Dark', 'Sapphire', 'Amethyst' },
    callback = function(value)
        Library:SetTheme(value)
    end
})

tab3.create_toggle({
    name = 'Auto Save Flags',
    flag = 'autosave',
    section = 'right',
    enabled = true,
    callback = function(state) end
})

tab3.create_button({
    name = 'Reset All Flags',
    section = 'right',
    callback = function()
        for _, obj in pairs(Library.Objects) do
            if obj.SetValue then
                pcall(function() obj:SetValue(nil) end)
            end
        end
    end
})

tab3.create_button({
    name = 'Unload UI',
    section = 'right',
    callback = function()
        Library:disconnect()
        Library:clear()
    end
})


--[[

Window:
    Library:visible()                    -- toggle UI on/off
    Library:exist()                      -- is UI alive
    Library:disconnect()                 -- disconnect all connections
    Library:clear()                      -- destroy UI

Configs:
    Library:SaveConfig(name)             -- Moondiety/Configs/<name>.json
    Library:LoadConfig(name)
    Library:DeleteConfig(name)
    Library:ListConfigs()                -- returns array of names

Themes:
    Library:SetTheme("Dark")
    Library:SetTheme("Sapphire")
    Library:SetTheme("Red")
    Library.Theme                        -- current theme name

]]



