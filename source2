            KeyText.TextSize = 12
            KeyText.TextXAlignment = Enum.TextXAlignment.Center

            registerItem(keybind, side, ELEMENT_HEIGHT)

            local function displayOf(v)
                if not v then return "" end
                local n = tostring(v):match("^MouseButton(%d+)$")
                if n then return "Mouse" .. n end
                return tostring(v)
            end

            local function pressedName(input)
                if input.UserInputType == Enum.UserInputType.Keyboard then
                    return input.KeyCode.Name
                end
                local n = input.UserInputType.Name
                if n:match("^MouseButton%d+$") then return n end
                return nil
            end

            local defaultKey = self.keycode and self.keycode.Name or "H"
            Library.Flags[self.flag] = Library.Flags[self.flag] or defaultKey
            if Library.savedFlags and Library.savedFlags[self.flag] then
                Library.Flags[self.flag] = Library.savedFlags[self.flag]
            end
            KeyText.Text = displayOf(Library.Flags[self.flag])

            local function updateSize()
                Box.Size = UDim2.new(0, math.max(40, KeyText.TextBounds.X + 12), 0, 22)
            end
            KeyText:GetPropertyChangedSignal("Text"):Connect(updateSize)
            updateSize()

            local setting = false
            local lastBound = 0

            bindTap(keybind, function()
                if setting then return end
                if tick() - lastBound < 0.2 then return end
                setting = true
                KeyText.Text = "..."
                local conn
                conn = UserInputService.InputBegan:Connect(function(input)
                    local name = pressedName(input)
                    if not name then return end
                    Library.Flags[self.flag] = name
                    Library.save_flags()
                    KeyText.Text = displayOf(name)
                    updateSize()
                    setting = false
                    lastBound = tick()
                    conn:Disconnect()
                end)
            end)

            UserInputService.InputBegan:Connect(function(input, gp)
                if gp then return end
                if setting then return end
                local name = pressedName(input)
                if not name then return end
                if name == Library.Flags[self.flag] then
                    if self.callback then self.callback(name) end
                end
            end)

            local KeybindObj = {}
            KeybindObj.flag = self.flag
            KeybindObj.callback = self.callback
            function KeybindObj:GetValue() return Library.Flags[self.flag] end
            function KeybindObj:SetValue(v)
                Library.Flags[self.flag] = v
                KeyText.Text = displayOf(v)
                updateSize()
            end

            Library:RegisterObject(self.flag, KeybindObj)
            return KeybindObj
        end

