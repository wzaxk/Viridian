function Library:SetTheme(name)
    ApplyTheme(name)
    if writefile then pcall(writefile, "Moondiety/theme.txt", name) end
end

function Library:RegisterObject(flag, object)
    if flag then self.Objects[flag] = object end
end

function Library:RefreshConfigs()
    local obj = self.Objects.savedconfigs
    if obj and obj.UpdateOptions then
        local list = self:ListConfigs()
        if #list == 0 then list = { 'None' } end
        pcall(function() obj:UpdateOptions(list) end)
    end
end

function Library:SaveConfig(name)
    name = name or "default"
    local data = {}
    for flag, obj in pairs(Library.Objects) do
        if obj.GetValue then
            local ok, v = pcall(function() return obj:GetValue() end)
            if ok and v ~= nil then data[flag] = v end
        end
    end
    if isfolder and not isfolder("Moondiety") then makefolder("Moondiety") end
    if isfolder and not isfolder("Moondiety/Configs") then makefolder("Moondiety/Configs") end
    local ok, encoded = pcall(function() return HttpService:JSONEncode(data) end)
    if ok and writefile then writefile("Moondiety/Configs/" .. name .. ".json", encoded) end
    self:RefreshConfigs()
    return ok
end

function Library:LoadConfig(name)
    name = name or "default"
    local path = "Moondiety/Configs/" .. name .. ".json"
    if not isfile or not isfile(path) then return false end
    local ok, data = pcall(function() return HttpService:JSONDecode(readfile(path)) end)
    if not ok or type(data) ~= "table" then return false end
    for flag, value in pairs(data) do
        local obj = Library.Objects[flag]
        if obj then
            if obj.SetValue then pcall(function() obj:SetValue(value) end) end
            if obj.callback then pcall(function() obj.callback(value) end) end
        end
    end
    return true
end

function Library:ListConfigs()
    if not isfolder or not isfolder("Moondiety/Configs") then return {} end
    local list = {}
    for _, file in ipairs(listfiles("Moondiety/Configs")) do
        local n = file:match("([^/\\]+)%.json$")
        if n then table.insert(list, n) end
    end
    return list
end

function Library:DeleteConfig(name)
    local path = "Moondiety/Configs/" .. name .. ".json"
    if isfile and isfile(path) then delfile(path) end
    self:RefreshConfigs()
end

if isfolder and not isfolder("Moondiety") then makefolder("Moondiety") end
if isfile and isfile("Moondiety/theme.txt") then
    local ok, themeName = pcall(readfile, "Moondiety/theme.txt")
    if ok and themeName and Themes[themeName] then ApplyTheme(themeName) end
end

function Library:disconnect()
    for _, value in Library.connections do
        if not Library.connections[value] then continue end
        Library.connections[value]:Disconnect()
        Library.connections[value] = nil
    end
end

function Library:clear()
    for _, object in CoreGui:GetChildren() do
        if object.Name ~= "cac" then continue end
        object:Destroy()
    end
end

function Library:exist()
    if not Library.core then return end
    if not Library.core.Parent then return end
    return true
end

function Library:save_flags()
    if not Library.exist() then return end
    local data = {}
    for flag, obj in pairs(Library.Objects) do
        if obj.GetValue then
            local ok, v = pcall(function() return obj:GetValue() end)
            if ok and v ~= nil then data[flag] = v end
        end
    end
    local ok, encoded = pcall(function() return HttpService:JSONEncode(data) end)
    if not ok then return end
    if isfolder and not isfolder("cac hub") then makefolder("cac hub") end
    if writefile then writefile("cac hub/" .. game.GameId .. ".lua", encoded) end
end

function Library:load_flags()
    local path = "cac hub/" .. game.GameId .. ".lua"
    if not isfile or not isfile(path) then return end
    local content = readfile(path)
    local ok, data = pcall(function() return HttpService:JSONDecode(content) end)
    if not ok or type(data) ~= "table" then return end
    Library.savedFlags = data
end

