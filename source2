            local function updateSVFromXY(absX, absY)
                local svPos = SV.AbsolutePosition
                local svSize = SV.AbsoluteSize
                if svSize.X <= 0 or svSize.Y <= 0 then return end
                s = math.clamp((absX - svPos.X) / svSize.X, 0, 1)
                v = 1 - math.clamp((absY - svPos.Y) / svSize.Y, 0, 1)
                refreshVisuals(false, true)
            end

            local function updateHueFromX(absX)
                local hPos = HueBar.AbsolutePosition
                local hSize = HueBar.AbsoluteSize
                if hSize.X <= 0 then return end
                h = math.clamp((absX - hPos.X) / hSize.X, 0, 1)
                refreshVisuals(false, true)
            end

            SV.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    draggingSV = true
                    updateSVFromXY(input.Position.X, input.Position.Y)
                end
            end)
            HueBar.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    draggingHue = true
                    updateHueFromX(input.Position.X)
                end
            end)

            UserInputService.InputChanged:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
                    if draggingSV then
                        updateSVFromXY(input.Position.X, input.Position.Y)
                    elseif draggingHue then
                        updateHueFromX(input.Position.X)
                    end
                end
            end)
            UserInputService.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    if draggingSV or draggingHue then
                        draggingSV = false
                        draggingHue = false
                        if Library.save_flags then Library.save_flags() end
                        resetCursor()
                    end
                end
            end)

