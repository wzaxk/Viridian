            UIPadding_2.PaddingTop = UDim.new(0, PADDING_TOP)
            UIPadding_2.PaddingBottom = UDim.new(0, PADDING_BOTTOM)

            local UIListLayout_2 = Instance.new("UIListLayout")
            UIListLayout_2.Parent = Options
            UIListLayout_2.SortOrder = Enum.SortOrder.LayoutOrder
            UIListLayout_2.Padding = UDim.new(0, OPTION_GAP)

            local Dropdown = {}
            Dropdown.selectedOption = nil

            function Dropdown:open()
                open = true
                TweenService:Create(Options, TweenInfo.new(0.4), {Size = UDim2.new(1, 0, 0, optionsHeight)}):Play()
                TweenService:Create(dropdown, TweenInfo.new(0.4), {Size = UDim2.new(0.96, 0, 0, ELEMENT_HEIGHT + optionsHeight)}):Play()
                TweenService:Create(Arrow, TweenInfo.new(0.4), {Rotation = 180}):Play()
            end

            function Dropdown:close()
                open = false
                TweenService:Create(Options, TweenInfo.new(0.4), {Size = UDim2.new(1, 0, 0, 0)}):Play()
                TweenService:Create(dropdown, TweenInfo.new(0.4), {Size = UDim2.new(0.96, 0, 0, ELEMENT_HEIGHT)}):Play()
                TweenService:Create(Arrow, TweenInfo.new(0.4), {Rotation = 0}):Play()
            end

            function Dropdown:clear()
                for _, object in Options:GetChildren() do
                    if object.Name == "Option" then object:Destroy() end
                end
            end

            function Dropdown:update()
                self:clear()
                local count = 0
                for _, value in ipairs(self.options) do
                    count += 1
                    local new_option = option:Clone()
                    new_option.Parent = Options
                    new_option.Text = value
                    new_option.ZIndex = 4
                    new_option.TextTransparency = (value == self.selectedOption) and 0 or 0.5
                    new_option.MouseEnter:Connect(function()
                        TweenService:Create(new_option, TweenInfo.new(0.3), {TextTransparency = 0}):Play()
                    end)
                    new_option.MouseLeave:Connect(function()
                        if new_option.Text ~= self.selectedOption then
                            TweenService:Create(new_option, TweenInfo.new(0.3), {TextTransparency = 0.5}):Play()
                        end
                    end)
                    new_option.MouseButton1Click:Connect(function()
                        self.selectedOption = value
                        TextLabel.Text = value
                        Library.Flags[self.flag] = value
                        if self.callback then self.callback(value) end
                        Library.save_flags()
                        self:update()
                        self:close()
                    end)
                end
                optionsHeight = 0
                if count > 0 then
                    optionsHeight = count * OPTION_HEIGHT + (count - 1) * OPTION_GAP + PADDING_TOP + PADDING_BOTTOM
                end
                if open then
                    TweenService:Create(Options, TweenInfo.new(0.4), {Size = UDim2.new(1, 0, 0, optionsHeight)}):Play()
                    TweenService:Create(dropdown, TweenInfo.new(0.4), {Size = UDim2.new(0.96, 0, 0, ELEMENT_HEIGHT + optionsHeight)}):Play()
                end
            end

            function Dropdown:UpdateOptions(newOptions)
                self.options = newOptions
                self:update()
            end
            function Dropdown:GetValue() return self.selectedOption end
            function Dropdown:SetValue(v)
                self.selectedOption = v
                TextLabel.Text = v or ""
                Library.Flags[self.flag] = v
                self:update()
            end

            Dropdown.options = self.options
            Dropdown.flag = self.flag
            Dropdown.callback = self.callback
            Dropdown:update()

            Library.Flags[self.flag] = Dropdown.selectedOption
            Library:RegisterObject(self.flag, Dropdown)

            Box.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    if open then Dropdown:close() else Dropdown:open() end
                end
            end)

            return Dropdown
        end

        function Module:create_multidropdown()
            local section = pickSection(self)
            local open = false
            local OPTION_HEIGHT = 20
            local OPTION_GAP = 6
            local PADDING_TOP = 8
            local PADDING_BOTTOM = 8
            local optionsHeight = 0

            local optionTemplate = Instance.new("TextButton")
