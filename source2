                    TweenService:Create(Switch, ti, {BackgroundColor3 = genv.togglecoloroff or Color3.fromRGB(60, 64, 72)}):Play()
                end
                Library.save_flags()
                if not skipCallback and self.callback then self.callback(self.state) end
            end

            function obj:GetValue() return self.state end
            function obj:SetValue(v) self:UpdateToggle(v, true) end

            Library.Flags[self.flag] = obj.state
            Library:RegisterObject(self.flag, obj)
            obj:UpdateToggle(obj.state, true)
            return obj
        end

