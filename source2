        function Module:create_slider()
            local side = getSide(self)
            local PADL, PADR = 4, 4

            local slider = row("slider", "slider")

            local track = new("Frame", {
                Name = "trackcolor",
                AnchorPoint = Vector2.new(0.5, 0.5),
                Position = UDim2.new(0.5, 0, 0.78, 0),
                Size = UDim2.new(0.9, 0, 0, 5),
                BackgroundColor3 = genv.trackcolor or Color3.fromRGB(40, 40, 40),
                BorderSizePixel = 0,
                Active = true,
            }, slider)
            table.insert(genv.UIElements, track)
            pill(track)

            local fill = new("Frame", {
                Name = "sliderfill",
                AnchorPoint = Vector2.new(0, 0.5),
                Position = UDim2.new(0, 0, 0.5, 0),
                Size = UDim2.new(0, 0, 1, 0),
                BackgroundColor3 = genv.sliderfill or Color3.fromRGB(90, 90, 90),
                BorderSizePixel = 0,
            }, track)
            table.insert(genv.UIElements, fill)
            pill(fill)

            local knob = new("Frame", {
                Name = "knob",
                Size = UDim2.new(0, 15, 0, 15),
                AnchorPoint = Vector2.new(0.5, 0.5),
                Position = UDim2.new(0, 0, 0.5, 0),
                BackgroundColor3 = genv.knob or Color3.fromRGB(120, 120, 120),
                BorderSizePixel = 0,
                Active = true,
            }, track)
            table.insert(genv.UIElements, knob)
            pill(knob)

            local hole = new("Frame", {
                AnchorPoint = Vector2.new(0.5, 0.5),
                Position = UDim2.new(0.5, 0, 0.5, 0),
                Size = UDim2.new(0.5, 0, 0.5, 0),
                BackgroundColor3 = Color3.fromRGB(27, 28, 33),
                BorderSizePixel = 0,
            }, knob)
            pill(hole)

            new("TextLabel", {
                AnchorPoint = Vector2.new(0, 0.5),
                Position = UDim2.new(0, 12, 0.32, 0),
                Size = UDim2.new(1, -70, 0, 13),
                BackgroundTransparency = 1,
                FontFace = font(),
                TextColor3 = WHITE,
                TextSize = 13,
                TextXAlignment = Enum.TextXAlignment.Left,
                Text = self.name or "",
            }, slider)

            local number = new("TextLabel", {
                AnchorPoint = Vector2.new(1, 0.5),
                Position = UDim2.new(0.97, 0, 0.32, 0),
                Size = UDim2.new(0, 50, 0, 13),
                BackgroundTransparency = 1,
                FontFace = font(),
                TextColor3 = WHITE,
                TextSize = 13,
                TextXAlignment = Enum.TextXAlignment.Right,
                Text = "0",
            }, slider)

            registerItem(slider, side, ELEMENT_HEIGHT)

            local min_v = tonumber(self.minimum_value) or 0
            local max_v = tonumber(self.maximum_value) or 100
            if max_v <= min_v then max_v = min_v + 1 end

            local step = tonumber(self.step)
            if not step or step <= 0 then
                local range = max_v - min_v
                if min_v == math.floor(min_v) and max_v == math.floor(max_v) and range >= 1 then step = 1
                elseif range <= 1 then step = 0.01
                elseif range <= 10 then step = 0.1
                elseif range <= 100 then step = 0.5
                else step = 1 end
            end

            local decimals = 3
            if step >= 1 then decimals = 0
            elseif step >= 0.1 then decimals = 1
            elseif step >= 0.01 then decimals = 2 end

            local function roundValue(val)
                if type(val) ~= "number" then return min_v end
                local rounded = math.floor((val - min_v) / step + 0.5) * step + min_v
                rounded = math.clamp(rounded, min_v, max_v)
                if decimals > 0 then
                    rounded = tonumber(string.format("%." .. decimals .. "f", rounded)) or min_v
                else
                    rounded = math.floor(rounded + 0.5)
                end
                return math.clamp(rounded, min_v, max_v)
            end

            local function formatNumber(value)
                if decimals > 0 then return string.format("%." .. decimals .. "f", value) end
                return tostring(math.floor(value + 0.5))
            end

            local function setFromPercent(percent)
                percent = math.clamp(tonumber(percent) or 0, 0, 1)
                local trackWidth = track.AbsoluteSize.X
                if trackWidth > 0 then
                    local pixelX = PADL + percent * (trackWidth - PADL - PADR)
                    fill.Size = UDim2.new(0, pixelX, 1, 0)
                    knob.Position = UDim2.new(0, pixelX, 0.5, 0)
                else
                    fill.Size = UDim2.new(percent, 0, 1, 0)
                    knob.Position = UDim2.new(percent, 0, 0.5, 0)
                end
                local final = roundValue(min_v + percent * (max_v - min_v))
                Library.Flags[self.flag] = final
                number.Text = formatNumber(final)
                if self.callback then self.callback(final) end
            end

            local function updateFromX(x)
                local trackWidth = track.AbsoluteSize.X
                if trackWidth <= 0 then return end
                local minX = track.AbsolutePosition.X + PADL
                setFromPercent((x - minX) / (trackWidth - PADL - PADR))
            end

            local initialValue
            if type(Library.Flags[self.flag]) == "number" then
                initialValue = Library.Flags[self.flag]
            elseif Library.savedFlags and type(Library.savedFlags[self.flag]) == "number" then
                initialValue = Library.savedFlags[self.flag]
            else
                initialValue = tonumber(self.value) or min_v
            end
            Library.Flags[self.flag] = roundValue(initialValue)
            setFromPercent(math.clamp((Library.Flags[self.flag] - min_v) / (max_v - min_v), 0, 1))

            task.defer(function()
                if track.AbsoluteSize.X > 0 then
                    setFromPercent(math.clamp((Library.Flags[self.flag] - min_v) / (max_v - min_v), 0, 1))
                end
            end)

            local dragging = false
            local slideInput

            local function animate(size)
                TweenService:Create(knob, TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Size = size}):Play()
            end

            local function beginDrag(input)
                if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then return end
                dragging = true
                slideInput = input
                Library.slider_drag = true
                Library.dragging = false
                itemsSection.ScrollingEnabled = false
                animate(UDim2.new(0, 18, 0, 18))
                updateFromX(input.Position.X)
            end

            local function endDrag()
                dragging = false
                Library.slider_drag = false
                itemsSection.ScrollingEnabled = true
                animate(UDim2.new(0, 15, 0, 15))
                Library.save_flags()
            end

            track.InputBegan:Connect(beginDrag)
            knob.InputBegan:Connect(beginDrag)
            slider.InputBegan:Connect(beginDrag)

            bind(UserInputService.InputChanged, function(input)
                if not dragging then return end
                if input.UserInputType == Enum.UserInputType.Touch then
                    if input == slideInput then updateFromX(input.Position.X) end
                elseif input.UserInputType == Enum.UserInputType.MouseMovement then
                    updateFromX(input.Position.X)
                end
            end)

            bind(UserInputService.InputEnded, function(input)
                if dragging and (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) then
                    endDrag()
                end
            end)

            local obj = {min = min_v, max = max_v, step = step, flag = self.flag, callback = self.callback}
            function obj:GetValue() return Library.Flags[self.flag] end
            function obj:SetValue(value)
                if type(value) ~= "number" then return end
                setFromPercent(math.clamp((value - self.min) / (self.max - self.min), 0, 1))
                Library.save_flags()
            end

            Library:RegisterObject(self.flag, obj)
            return obj
        end

