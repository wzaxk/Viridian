            local Dropdown = {}
            local parentScroll = getParentScrollingFrame(dropdown)
            local animToken = 0
            Dropdown.selectedOption = nil

            function Dropdown:open()
                open = true
                animToken += 1
                Options.Visible = true
                dropdown.ZIndex = 50; Box.ZIndex = 51; Options.ZIndex = 52
                Title.ZIndex = 53; Selected.ZIndex = 53; Arrow.ZIndex = 53
                for _, child in ipairs(Options:GetChildren()) do
                    if child.Name == "Option" then child.ZIndex = 53 end
                end
                local targetHeight = math.min(16 + list_size, MAX_HEIGHT)
                TweenService:Create(Options, TweenInfo.new(0.5), {Size = UDim2.new(1, 0, 0, targetHeight)}):Play()
                TweenService:Create(Arrow, TweenInfo.new(0.5), {Rotation = 180}):Play()
            end

            function Dropdown:close()
                open = false
                animToken += 1
                local myToken = animToken
                if parentScroll then parentScroll.ScrollingEnabled = true end
                local tw = TweenService:Create(Options, TweenInfo.new(0.5), {Size = UDim2.new(1, 0, 0, 0)})
                tw:Play()
                TweenService:Create(Arrow, TweenInfo.new(0.5), {Rotation = 0}):Play()
                tw.Completed:Once(function()
                    if myToken ~= animToken then return end
                    Options.Visible = false
                    Options.CanvasPosition = Vector2.new(0, 0)
                    dropdown.ZIndex = 1; Box.ZIndex = 2; Options.ZIndex = 2
                    Title.ZIndex = 1; Selected.ZIndex = 2; Arrow.ZIndex = 2
                    for _, child in ipairs(Options:GetChildren()) do
                        if child.Name == "Option" then child.ZIndex = 2 end
                    end
                end)
            end

            function Dropdown:clear()
                for _, object in Options:GetChildren() do
                    if object.Name == "Option" then object:Destroy() end
                end
            end

            function Dropdown:update()
                self:clear()
                list_size = 0
                for _, value in ipairs(self.options) do
                    list_size += OPTION_HEIGHT
                    local new_option = option:Clone()
                    new_option.Parent = Options
                    new_option.Text = value
                    new_option.ZIndex = open and 53 or 2
                    new_option.TextTransparency = (value == self.selectedOption) and 0 or 0.5
                    new_option.MouseEnter:Connect(function()
                        TweenService:Create(new_option, TweenInfo.new(0.3), {TextTransparency = 0}):Play()
                    end)
                    new_option.MouseLeave:Connect(function()
                        if new_option.Text ~= self.selectedOption then
                            TweenService:Create(new_option, TweenInfo.new(0.3), {TextTransparency = 0.5}):Play()
                        end
                    end)
                    bindTap(new_option, function()
                        self.selectedOption = value
                        Selected.Text = value
                        Library.Flags[self.flag] = value
                        if self.callback then self.callback(value) end
                        Library.save_flags()
                        self:update()
                        self:close()
                    end)
                end
                Options.CanvasSize = UDim2.new(0, 0, 0, list_size + 16)
                Options.CanvasPosition = Vector2.new(0, 0)
            end

            function Dropdown:UpdateOptions(newOptions)
                self.options = newOptions
                self:update()
            end
            function Dropdown:GetValue() return self.selectedOption end
            function Dropdown:SetValue(v)
                self.selectedOption = v
                Selected.Text = v or ""
                Library.Flags[self.flag] = v
                self:update()
            end

