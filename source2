            local function updateHex()
                local c = Color3.fromHSV(h, s, v)
                local r = math.floor(c.R * 255 + 0.5)
                local g = math.floor(c.G * 255 + 0.5)
                local b = math.floor(c.B * 255 + 0.5)
                HexLabel.Text = string.format("#%02X%02X%02X", r, g, b)
                return c, r, g, b
            end

            local setFromColor

            local function refreshVisuals(skipCallback, skipSave)
                SV.BackgroundColor3 = Color3.fromHSV(h, 1, 1)
                SVCursor.Position = UDim2.new(s, 0, 1 - v, 0)
                HueCursor.Position = UDim2.new(h, 0, 0.5, 0)
                local c, r, g, b = updateHex()
                Preview.BackgroundColor3 = c
                ColorSquare.BackgroundColor3 = c
                Library.Flags[self.flag .. "_color"] = {r, g, b}
                if not skipCallback and self.color_callback then self.color_callback(c) end
                if not skipSave and Library.save_flags then Library.save_flags() end
                return c, r, g, b
            end

            setFromColor = function(color)
                h, s, v = color:ToHSV()
                refreshVisuals(true, true)
            end

            local savedTable
            if Library.savedFlags and type(Library.savedFlags[self.flag .. "_color"]) == "table" then
                savedTable = Library.savedFlags[self.flag .. "_color"]
            end
            if savedTable and #savedTable >= 3 then
                setFromColor(Color3.fromRGB(savedTable[1], savedTable[2], savedTable[3]))
            else
                setFromColor(ColorSquare.BackgroundColor3)
            end

            local draggingSV = false
            local draggingHue = false

            local function updateSVFromXY(absX, absY)
                local svPos = SV.AbsolutePosition
                local svSize = SV.AbsoluteSize
                if svSize.X <= 0 or svSize.Y <= 0 then return end
                s = math.clamp((absX - svPos.X) / svSize.X, 0, 1)
                v = 1 - math.clamp((absY - svPos.Y) / svSize.Y, 0, 1)
                refreshVisuals(false, true)
            end

            local function updateHueFromX(absX)
                local hPos = HueBar.AbsolutePosition
                local hSize = HueBar.AbsoluteSize
                if hSize.X <= 0 then return end
                h = math.clamp((absX - hPos.X) / hSize.X, 0, 1)
                refreshVisuals(false, true)
            end

            SV.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    draggingSV = true
                    updateSVFromXY(input.Position.X, input.Position.Y)
                end
            end)
            HueBar.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    draggingHue = true
                    updateHueFromX(input.Position.X)
                end
            end)

            UserInputService.InputChanged:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
                    if draggingSV then
                        updateSVFromXY(input.Position.X, input.Position.Y)
                    elseif draggingHue then
                        updateHueFromX(input.Position.X)
                    end
                end
            end)
            UserInputService.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    if draggingSV or draggingHue then
                        draggingSV = false
                        draggingHue = false
                        if Library.save_flags then Library.save_flags() end
                        resetCursor()
                    end
                end
            end)

            local ToggleObject = {}
            ToggleObject.state = self.enabled or false
            if Library.savedFlags and type(Library.savedFlags[self.flag]) == "boolean" then
                ToggleObject.state = Library.savedFlags[self.flag]
            end
            ToggleObject.callback = self.callback
            ToggleObject.flag = self.flag

            function ToggleObject:UpdateToggle(newState, skipCallback)
                if newState ~= nil then self.state = newState else self.state = not self.state end
                Library.Flags[self.flag] = self.state
                Switch:SetAttribute("State", self.state)
                local ti = TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
                if self.state then
                    TweenService:Create(Circle, ti, {Position = UDim2.new(1, -13, 0.5, 0)}):Play()
                    TweenService:Create(Switch, ti, {BackgroundColor3 = getgenv().togglecoloron or Color3.fromRGB(120, 120, 126)}):Play()
                else
                    TweenService:Create(Circle, ti, {Position = UDim2.new(0, 2, 0.5, 0)}):Play()
                    TweenService:Create(Switch, ti, {BackgroundColor3 = getgenv().togglecoloroff or Color3.fromRGB(60, 64, 72)}):Play()
                end
                if Library.save_flags then Library.save_flags() end
                if not skipCallback and self.callback then self.callback(self.state) end
            end

            function ToggleObject:GetValue() return self.state end
            function ToggleObject:SetValue(vv) self:UpdateToggle(vv, true) end
            function ToggleObject:GetColor() return Color3.fromHSV(h, s, v) end
            function ToggleObject:SetColor(c) setFromColor(c); Library.save_flags() end

            Library.Flags[self.flag] = ToggleObject.state
            Library:RegisterObject(self.flag, ToggleObject)
            ToggleObject:UpdateToggle(ToggleObject.state, true)

            local ColorObject = {}
            function ColorObject:GetValue() return Library.Flags[self.flag .. "_color"] end
            function ColorObject:SetValue(vv)
                if type(vv) == "table" and #vv >= 3 then
                    setFromColor(Color3.fromRGB(vv[1], vv[2], vv[3]))
                end
            end
            Library:RegisterObject(self.flag .. "_color", ColorObject)

            local syncConn
            local function syncPosition()
                if not toggle or not toggle.Parent then return end
                local tAbs = toggle.AbsolutePosition
                local tSize = toggle.AbsoluteSize
                local cAbs = Container.AbsolutePosition
                local cSize = Container.AbsoluteSize
                local px = tAbs.X - cAbs.X + tSize.X + 8
                local py = tAbs.Y - cAbs.Y
                if px + Palette.AbsoluteSize.X > cSize.X - 4 then
                    px = tAbs.X - cAbs.X - Palette.AbsoluteSize.X - 8
                end
                if py + Palette.AbsoluteSize.Y > cSize.Y - 4 then
                    py = cSize.Y - Palette.AbsoluteSize.Y - 4
                end
                if py < 4 then py = 4 end
                Palette.Position = UDim2.fromOffset(px, py)
            end

            local function openPalette()
                open = true
                Palette.Visible = true
                syncPosition()
                if syncConn then syncConn:Disconnect() end
                syncConn = RunService.Heartbeat:Connect(function()
                    if open then syncPosition() end
                end)
            end

            local function closePalette()
                open = false
                Palette.Visible = false
                if syncConn then syncConn:Disconnect(); syncConn = nil end
                resetCursor()
            end

            bindTap(CloseBtn, closePalette)

            toggle.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    local pos = input.Position
                    local csAbs = ColorSquare.AbsolutePosition
                    local csSize = ColorSquare.AbsoluteSize
                    local overColorSquare = pos.X >= csAbs.X and pos.X <= csAbs.X + csSize.X
                        and pos.Y >= csAbs.Y and pos.Y <= csAbs.Y + csSize.Y
                    if overColorSquare then
                        if open then closePalette() else openPalette() end
                    else
                        if open then closePalette() else ToggleObject:UpdateToggle() end
                    end
                end
            end)

            return ToggleObject
        end

