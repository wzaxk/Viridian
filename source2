function ApplyTheme(name)
    local theme = Themes[name] or Themes.Dark
    for key, value in pairs(theme) do getgenv()[key] = value end
    Library.Theme = name
    local tweenInfo = TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
    for _, obj in pairs(getgenv().UIElements) do
        if obj.Name == "Switch" then
            local isOn = obj:GetAttribute("State"); if isOn == nil then isOn = false end
            TweenService:Create(obj, tweenInfo, {BackgroundColor3 = isOn and getgenv().togglecoloron or getgenv().togglecoloroff}):Play()
        end
        if obj.Name == "Button" and getgenv().buttoncolor then obj.BackgroundColor3 = getgenv().buttoncolor end
        if obj.Name == "slider" and getgenv().slider then obj.BackgroundColor3 = getgenv().slider end
        if obj.Name == "Box1" and getgenv().multidropdownboxcolor then obj.BackgroundColor3 = getgenv().multidropdownboxcolor end
        if obj.Name == "Options1" and getgenv().multidropdownoptioncolor then obj.BackgroundColor3 = getgenv().multidropdownoptioncolor end
        if obj.Name == "multisidedropdownBox" and getgenv().multisidedropdownBox then obj.BackgroundColor3 = getgenv().multisidedropdownBox end
        if obj.Name == "multisidedropdown" and getgenv().multisidedropdown then obj.BackgroundColor3 = getgenv().multisidedropdown end
        if obj.Name == "multisidedropdownOptions" and getgenv().multisidedropdownOptions then obj.BackgroundColor3 = getgenv().multisidedropdownOptions end
        if obj.Name == "dropdown1" and getgenv().multidropdowncolor then obj.BackgroundColor3 = getgenv().multidropdowncolor end
        if obj.Name == "SideBox" and getgenv().sidedropdownboxcolor then obj.BackgroundColor3 = getgenv().sidedropdownboxcolor end
        if obj.Name == "SideDropdown" and getgenv().sidedropdowncolor then obj.BackgroundColor3 = getgenv().sidedropdowncolor end
        if obj.Name == "SideOptions" and getgenv().sidedropdownoptionscolor then obj.BackgroundColor3 = getgenv().sidedropdownoptionscolor end
        if obj.Name == "Dropdown" and getgenv().dropdowncolor then obj.BackgroundColor3 = getgenv().dropdowncolor end
        if obj.Name == "Box" and getgenv().dropdownboxscolor then obj.BackgroundColor3 = getgenv().dropdownboxscolor end
        if obj.Name == "Options" and getgenv().dropdownoptionscolor then obj.BackgroundColor3 = getgenv().dropdownoptionscolor end
        if obj.Name == "trackcolor" and getgenv().trackcolor then obj.BackgroundColor3 = getgenv().trackcolor end
        if obj.Name == "sliderfill" and getgenv().sliderfill then obj.BackgroundColor3 = getgenv().sliderfill end
        if obj.Name == "knob" and getgenv().knob then obj.BackgroundColor3 = getgenv().knob end
        if obj.Name == "Input" and getgenv().inputButton then obj.BackgroundColor3 = getgenv().inputButton end
        if obj.Name == "InputBox" and getgenv().InputBox then obj.BackgroundColor3 = getgenv().InputBox end
        if obj.Name == "Keybind" and getgenv().Keybind then obj.BackgroundColor3 = getgenv().Keybind end
        if obj.Name == "KeybindBox" and getgenv().KeybindBox then obj.BackgroundColor3 = getgenv().KeybindBox end
        if obj.Name == "Checkbox" and getgenv().checkboxturnoff then obj.BackgroundColor3 = getgenv().checkboxturnoff end
        if obj.Name == "Toggle" and getgenv().togglecolor then obj.BackgroundColor3 = getgenv().togglecolor end
        if obj.Name == "Checkbox1" and getgenv().checkboxcolor then obj.BackgroundColor3 = getgenv().checkboxcolor end
        if obj.Name == "Container" and getgenv().uicontainer then obj.BackgroundColor3 = getgenv().uicontainer end
        if (obj.Name == "StickyLeft" or obj.Name == "StickyRight" or obj.Name == "StickyMerge") and getgenv().uicontainer then obj.BackgroundColor3 = getgenv().uicontainer end
        if obj.Name == "Line" and getgenv().uiline then obj.BackgroundColor3 = getgenv().uiline end
