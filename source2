local function bindTap(gui, callback)
    if not gui then return end
    local lastFire = 0
    local function fire(...)
        local now = tick()
        if now - lastFire < 0.15 then return end
        lastFire = now
        callback(...)
    end
    gui.MouseButton1Click:Connect(fire)
    pcall(function() gui.TouchTap:Connect(fire) end)
    gui.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch then
            fire()
        end
    end)
end

