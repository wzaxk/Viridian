            knob.Position = UDim2.new(0, 0, 0.5, 0)
            knob.BackgroundColor3 = getgenv().knob or Color3.fromRGB(120, 120, 120)
            knob.BorderSizePixel = 0
            knob.Active = true
            knob.Selectable = true
            table.insert(getgenv().UIElements, knob)

            local knobCorner = Instance.new("UICorner")
