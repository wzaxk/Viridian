            dropdown1.BackgroundColor3 = getgenv().multidropdowncolor or Color3.fromRGB(27, 28, 33)
            dropdown1.BorderSizePixel = 0
            dropdown1.Size = UDim2.new(0.96, 0, 0, ELEMENT_HEIGHT)
            dropdown1.AutoButtonColor = false
            dropdown1.Text = ""
