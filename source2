        local function updateSticky(section, list, layer)
            if not section.Visible or not section.Parent then
                layer.Visible = false
                for _, e in ipairs(list) do e.clone.Visible = false end
                return
            end
            local secTop = section.AbsolutePosition.Y
            local anyStuck = false
            for i, entry in ipairs(list) do
                local relCenter = entry.title.AbsolutePosition.Y - secTop
                local h = entry.title.AbsoluteSize.Y
                local halfH = h * 0.0001
                local bottom = relCenter + halfH

                if bottom > 0 then
                    entry.clone.Visible = false
                else
                    local pushY = 0
                    local nextEntry = list[i + 1]
                    if nextEntry then
                        local nextCenter = nextEntry.title.AbsolutePosition.Y - secTop
                        local nextHalfH = nextEntry.title.AbsoluteSize.Y * 0.5
                        local nextTop = nextCenter - nextHalfH
                        if nextTop < h then
                            pushY = nextTop - h
                        end
                    end
                    if pushY + h <= 7 then
                        entry.clone.Visible = false
                    else
                        entry.clone.Position = UDim2.new(0, 0, 0, pushY)
                        entry.clone.Visible = true
                        anyStuck = true
                    end
                end
            end
            layer.Visible = anyStuck
        end


