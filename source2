            if Library.savedFlags and Library.savedFlags[self.flag] ~= nil then
                Dropdown.selectedOption = Library.savedFlags[self.flag]
                Selected.Text = Library.savedFlags[self.flag]
            end
            Dropdown.options = self.options
            Dropdown.flag = self.flag
            Dropdown.callback = self.callback
            Dropdown:update()

            Library.Flags[self.flag] = Dropdown.selectedOption
            Library:RegisterObject(self.flag, Dropdown)

