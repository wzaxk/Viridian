            ToggleObject.state = self.enabled or false
            if Library.savedFlags and type(Library.savedFlags[self.flag]) == "boolean" then
                ToggleObject.state = Library.savedFlags[self.flag]
            end
            ToggleObject.callback = self.callback
            ToggleObject.flag = self.flag

            function ToggleObject:UpdateToggle(newState, skipCallback)
                if newState ~= nil then self.state = newState else self.state = not self.state end
                Library.Flags[self.flag] = self.state
                Switch:SetAttribute("State", self.state)
                local ti = TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
                if self.state then
                    TweenService:Create(Circle, ti, {Position = UDim2.new(1, -13, 0.5, 0)}):Play()
                    TweenService:Create(Switch, ti, {BackgroundColor3 = getgenv().togglecoloron or Color3.fromRGB(65, 130, 140)}):Play()
                else
                    TweenService:Create(Circle, ti, {Position = UDim2.new(0, 2, 0.5, 0)}):Play()
                    TweenService:Create(Switch, ti, {BackgroundColor3 = getgenv().togglecoloroff or Color3.fromRGB(60, 64, 72)}):Play()
                end
                if Library.save_flags then Library.save_flags() end
                if not skipCallback and self.callback then self.callback(self.state) end
            end

            function ToggleObject:GetValue() return self.state end
            function ToggleObject:SetValue(vv) self:UpdateToggle(vv, true) end
            function ToggleObject:GetColor() return Color3.fromHSV(h, s, v) end
            function ToggleObject:SetColor(c) setFromColor(c); Library.save_flags() end

            Library.Flags[self.flag] = ToggleObject.state
            Library:RegisterObject(self.flag, ToggleObject)
            ToggleObject:UpdateToggle(ToggleObject.state, true)

            local ColorObject = {}
            function ColorObject:GetValue() return Library.Flags[self.flag .. "_color"] end
            function ColorObject:SetValue(vv)
                if type(vv) == "table" and #vv >= 3 then
                    setFromColor(Color3.fromRGB(vv[1], vv[2], vv[3]))
                end
            end
            Library:RegisterObject(self.flag .. "_color", ColorObject)

            local syncConn
            local function syncPosition()
                if not toggle or not toggle.Parent then return end
                local tAbs = toggle.AbsolutePosition
                local tSize = toggle.AbsoluteSize
                local cAbs = Container.AbsolutePosition
                local cSize = Container.AbsoluteSize
                local px = tAbs.X - cAbs.X + tSize.X + 8
                local py = tAbs.Y - cAbs.Y
                if px + Palette.AbsoluteSize.X > cSize.X - 4 then
                    px = tAbs.X - cAbs.X - Palette.AbsoluteSize.X - 8
                end
                if py + Palette.AbsoluteSize.Y > cSize.Y - 4 then
                    py = cSize.Y - Palette.AbsoluteSize.Y - 4
                end
                if py < 4 then py = 4 end
                Palette.Position = UDim2.fromOffset(px, py)
            end

            local function openPalette()
                open = true
                Palette.Visible = true
                syncPosition()
                if syncConn then syncConn:Disconnect() end
                syncConn = game:GetService("RunService").Heartbeat:Connect(function()
                    if open then syncPosition() end
                end)
            end

            local function closePalette()
                open = false
                Palette.Visible = false
                if syncConn then syncConn:Disconnect(); syncConn = nil end
                resetCursor()
            end

            CloseBtn.MouseButton1Click:Connect(closePalette)
            Palette.MouseButton1Click:Connect(function() end)

            toggle.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    local pos = input.Position
                    local csAbs = ColorSquare.AbsolutePosition
                    local csSize = ColorSquare.AbsoluteSize
                    local overColorSquare = pos.X >= csAbs.X and pos.X <= csAbs.X + csSize.X
                        and pos.Y >= csAbs.Y and pos.Y <= csAbs.Y + csSize.Y
                    if overColorSquare then
                        if open then closePalette() else openPalette() end
                    else
                        if open then closePalette() else ToggleObject:UpdateToggle() end
                    end
                end
            end)

            return ToggleObject
        end

