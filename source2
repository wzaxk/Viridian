            local Box1 = Instance.new("Frame")
            Box1.Name = "Box1"
            Box1.Parent = dropdown1
            Box1.AnchorPoint = Vector2.new(0.5, 0)
            Box1.Position = UDim2.new(0.5, 0, 0, 5)
            Box1.Size = UDim2.new(1, -12, 0, BOX_HEIGHT)
            Box1.BackgroundColor3 = getgenv().multidropdownboxcolor or Color3.fromRGB(22, 23, 27)
            Box1.BorderSizePixel = 0
            Box1.ZIndex = 2
            table.insert(getgenv().UIElements, Box1)

            local BoxCorner = Instance.new("UICorner")
            BoxCorner.CornerRadius = UDim.new(0, 6)
            BoxCorner.Parent = Box1

            local TextLabel = Instance.new("TextLabel")
            TextLabel.Parent = Box1
            TextLabel.AnchorPoint = Vector2.new(0, 0.5)
            TextLabel.Position = UDim2.new(0.05, 0, 0.5, 0)
            TextLabel.Size = UDim2.new(1, -30, 1, 0)
            TextLabel.BackgroundTransparency = 1
            TextLabel.FontFace = Font.new("rbxasset://fonts/families/Montserrat.json", Enum.FontWeight.SemiBold)
            TextLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
            TextLabel.TextSize = 12
            TextLabel.TextXAlignment = Enum.TextXAlignment.Left
            TextLabel.TextTruncate = Enum.TextTruncate.AtEnd
            TextLabel.ZIndex = 3

            local Arrow = Instance.new("ImageLabel")
            Arrow.Parent = Box1
            Arrow.AnchorPoint = Vector2.new(0.5, 0.5)
            Arrow.Position = UDim2.new(0.92, 0, 0.5, 0)
            Arrow.Size = UDim2.new(0, 10, 0, 10)
            Arrow.BackgroundTransparency = 1
            Arrow.Image = "rbxassetid://17400678941"
            Arrow.ZIndex = 3

            local Options = Instance.new("Frame")
            Options.Parent = Box1
            Options.Name = "Options1"
            Options.AnchorPoint = Vector2.new(0, 0)
            Options.Position = UDim2.new(0, 0, 1, 0)
            Options.Size = UDim2.new(1, 0, 0, 0)
            Options.BackgroundColor3 = getgenv().multidropdownoptioncolor or Color3.fromRGB(22, 23, 27)
            Options.BorderSizePixel = 0
            Options.ClipsDescendants = true
            Options.ZIndex = 3
            table.insert(getgenv().UIElements, Options)

            local OptionsCorner = Instance.new("UICorner")
            OptionsCorner.CornerRadius = UDim.new(0, 6)
            OptionsCorner.Parent = Options

            local UIPadding = Instance.new("UIPadding")
            UIPadding.Parent = Options
            UIPadding.PaddingLeft = UDim.new(0, 10)
            UIPadding.PaddingTop = UDim.new(0, PADDING_TOP)
            UIPadding.PaddingBottom = UDim.new(0, PADDING_BOTTOM)

            local UIListLayout = Instance.new("UIListLayout")
            UIListLayout.Parent = Options
            UIListLayout.SortOrder = Enum.SortOrder.LayoutOrder
            UIListLayout.Padding = UDim.new(0, OPTION_GAP)

            local Dropdown = {}
            Dropdown.options = self.options or {}
            Dropdown.selectedOptions = {}
            Dropdown.flag = self.flag
            Dropdown.callback = self.callback
            Dropdown.name = self.name

            function Dropdown:updateText()
                if #self.selectedOptions > 0 then
                    TextLabel.Text = table.concat(self.selectedOptions, ", ")
                else
                    TextLabel.Text = self.name
                end
            end

            function Dropdown:clearOptions()
                for _, child in ipairs(Options:GetChildren()) do
                    if child:IsA("TextButton") then child:Destroy() end
                end
            end

            function Dropdown:refreshOptions()
                self:clearOptions()
                local count = 0
                for _, value in ipairs(self.options) do
                    count += 1
                    local btn = optionTemplate:Clone()
                    btn.Parent = Options
                    btn.Text = value
                    btn.ZIndex = 4
                    btn.TextTransparency = table.find(self.selectedOptions, value) and 0 or 0.5
                    btn.MouseEnter:Connect(function()
                        TweenService:Create(btn, TweenInfo.new(0.3), {TextTransparency = 0}):Play()
                    end)
                    btn.MouseLeave:Connect(function()
                        if not table.find(self.selectedOptions, value) then
                            TweenService:Create(btn, TweenInfo.new(0.3), {TextTransparency = 0.5}):Play()
                        end
                    end)
                    btn.MouseButton1Click:Connect(function()
                        local idx = table.find(self.selectedOptions, value)
                        if idx then
                            table.remove(self.selectedOptions, idx)
                        else
                            table.insert(self.selectedOptions, value)
                        end
                        Library.Flags[self.flag] = self.selectedOptions
                        self:updateText()
                        self:refreshOptions()
                        if self.callback then self.callback(self.selectedOptions) end
                    end)
                end
                optionsHeight = 0
                if count > 0 then
                    optionsHeight = count * OPTION_HEIGHT + (count - 1) * OPTION_GAP + PADDING_TOP + PADDING_BOTTOM
                end
                if open then
                    TweenService:Create(Options, TweenInfo.new(0.4), {Size = UDim2.new(1, 0, 0, optionsHeight)}):Play()
                    TweenService:Create(dropdown1, TweenInfo.new(0.4), {Size = UDim2.new(0.96, 0, 0, ELEMENT_HEIGHT + optionsHeight)}):Play()
                end
            end

            function Dropdown:open()
                open = true
                TweenService:Create(Options, TweenInfo.new(0.4), {Size = UDim2.new(1, 0, 0, optionsHeight)}):Play()
                TweenService:Create(dropdown1, TweenInfo.new(0.4), {Size = UDim2.new(0.96, 0, 0, ELEMENT_HEIGHT + optionsHeight)}):Play()
                TweenService:Create(Arrow, TweenInfo.new(0.4), {Rotation = 180}):Play()
            end

            function Dropdown:close()
                open = false
                TweenService:Create(Options, TweenInfo.new(0.4), {Size = UDim2.new(1, 0, 0, 0)}):Play()
                TweenService:Create(dropdown1, TweenInfo.new(0.4), {Size = UDim2.new(0.96, 0, 0, ELEMENT_HEIGHT)}):Play()
                TweenService:Create(Arrow, TweenInfo.new(0.4), {Rotation = 0}):Play()
            end

            function Dropdown:UpdateOptions(newOptions)
                self.options = newOptions
                self.selectedOptions = {}
                self:updateText()
                self:refreshOptions()
            end
            function Dropdown:GetValue() return self.selectedOptions end
            function Dropdown:SetValue(v)
                if type(v) ~= "table" then return end
                self.selectedOptions = v
                Library.Flags[self.flag] = v
                self:updateText()
                self:refreshOptions()
            end

            if Library.savedFlags and type(Library.savedFlags[self.flag]) == "table" then
                Dropdown.selectedOptions = Library.savedFlags[self.flag]
            end

            TextLabel.Text = self.name
            Dropdown:updateText()
            Dropdown:refreshOptions()

            Library.Flags[self.flag] = Dropdown.selectedOptions
            Library:RegisterObject(self.flag, Dropdown)

            Box1.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    if open then Dropdown:close() else Dropdown:open() end
                end
            end)

            return Dropdown
        end

